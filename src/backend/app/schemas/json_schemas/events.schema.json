{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/events.schema.json",
    "title": "Kubernetes Visualization Event Stream",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "events"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "1.0"
        },
        "events": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/event"
            }
        }
    },
    "$defs": {
        "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "t",
                "kind"
            ],
            "properties": {
                "t": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Relative time in milliseconds"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "apply",
                        "reconcile_tick",
                        "reconcile_start",
                        "reconcile_end",
                        "pod_create",
                        "pod_delete",
                        "schedule_try",
                        "schedule_success",
                        "schedule_fail",
                        "bind_success",
                        "node_state_change"
                    ]
                },
                "actor": {
                    "type": "string",
                    "description": "Node/component initiating the event"
                },
                "target": {
                    "type": "string",
                    "description": "Target node/component"
                },
                "resource": {
                    "$ref": "#/$defs/resource_ref"
                },
                "controller": {
                    "type": "string",
                    "enum": [
                        "deployment",
                        "replicaset",
                        "node",
                        "job",
                        "hpa"
                    ]
                },
                "pod": {
                    "type": "string"
                },
                "node": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "details": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "apply"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "resource"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "schedule_try"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "pod"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "schedule_success"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "pod",
                            "node"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "schedule_fail"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "pod",
                            "reason"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "reconcile_tick"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "controller"
                        ]
                    }
                }
            ]
        },
        "resource_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "name"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "Deployment",
                        "ReplicaSet",
                        "Pod",
                        "Node",
                        "Job"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string",
                    "default": "default"
                }
            }
        }
    }
}